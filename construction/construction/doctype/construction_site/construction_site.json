{
    "doctype": "DocType",
    "name": "Construction Site",
    "module": "Construction",
    "autoname": "format:SITE-{YY}-{####}",
    "fields": [
        {"fieldname": "site_name", "label": "Site Name", "fieldtype": "Data", "reqd": 1, "in_list_view": 1},
        {"fieldname": "site_code", "label": "Site Code", "fieldtype": "Data", "reqd": 1, "unique": 1},
        {"fieldname": "address", "label": "Address", "fieldtype": "Small Text"},
        {"fieldname": "city", "label": "City", "fieldtype": "Data", "in_standard_filter": 1},
        {"fieldname": "state", "label": "State/Province", "fieldtype": "Data"},
        {"fieldname": "country", "label": "Country", "fieldtype": "Data"},
        {"fieldname": "coordinates", "label": "GPS Coordinates", "fieldtype": "Data"},
        {"fieldname": "site_manager", "label": "Site Manager", "fieldtype": "Link", "options": "User"},
        {"fieldname": "phone", "label": "Phone", "fieldtype": "Data"},
        {"fieldname": "email", "label": "Email", "fieldtype": "Data"},
        {"fieldname": "is_active", "label": "Is Active", "fieldtype": "Check", "default": 1, "in_list_view": 1}
    ],
    "permissions": [
        {"role": "System Manager", "permlevel": 0, "read": 1, "write": 1, "create": 1, "delete": 1},
        {"role": "Construction Project Manager", "permlevel": 0, "read": 1, "write": 1, "create": 1},
        {"role": "Site Engineer", "permlevel": 0, "read": 1}
    ]
}