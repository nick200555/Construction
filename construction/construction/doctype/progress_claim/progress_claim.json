{
    "doctype": "DocType",
    "name": "Progress Claim",
    "module": "Construction",
    "autoname": "format:PC-{project}-{####}",
    "is_submittable": 1,
    "track_changes": 1,
    "fields": [
        {
            "fieldname": "claim_id",
            "label": "Claim ID",
            "fieldtype": "Data",
            "read_only": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "project",
            "label": "Project",
            "fieldtype": "Link",
            "options": "Project",
            "reqd": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "claim_date",
            "label": "Claim Date",
            "fieldtype": "Date",
            "default": "Today",
            "reqd": 1
        },
        {
            "fieldname": "claim_period_from",
            "label": "Period From",
            "fieldtype": "Date",
            "reqd": 1
        },
        {
            "fieldname": "claim_period_to",
            "label": "Period To",
            "fieldtype": "Date",
            "reqd": 1
        },
        {
            "fieldname": "contract_value",
            "label": "Contract Value",
            "fieldtype": "Currency",
            "fetch_from": "project.contract_value",
            "read_only": 1
        },
        {
            "fieldname": "completion_percentage",
            "label": "Completion % to Date",
            "fieldtype": "Percent"
        },
        {
            "fieldname": "gross_claim",
            "label": "Gross Claim Amount",
            "fieldtype": "Currency"
        },
        {
            "fieldname": "previous_claim",
            "label": "Less: Previous Claim",
            "fieldtype": "Currency"
        },
        {
            "fieldname": "net_claim",
            "label": "Net Claim This Period",
            "fieldtype": "Currency",
            "read_only": 1
        },
        {
            "fieldname": "retention_amount",
            "label": "Less: Retention",
            "fieldtype": "Currency"
        },
        {
            "fieldname": "amount_due",
            "label": "Amount Due",
            "fieldtype": "Currency",
            "read_only": 1
        },
        {
            "fieldname": "status",
            "label": "Status",
            "fieldtype": "Select",
            "options": "Draft\nSubmitted\nApproved\nPartially Approved\nRejected\nPaid",
            "default": "Draft",
            "in_list_view": 1
        }
    ],
    "permissions": [
        {
            "role": "System Manager",
            "permlevel": 0,
            "read": 1,
            "write": 1,
            "create": 1,
            "delete": 1,
            "submit": 1,
            "cancel": 1,
            "amend": 1
        }
    ]
}