{
  "doctype": "DocType",
  "name": "Project",
  "module": "Construction",
  "autoname": "format:PROJ-{YY}-{####}",
  "is_submittable": 1,
  "track_changes": 1,
  "fields": [
    {"fieldname": "project_name", "label": "Project Name", "fieldtype": "Data", "reqd": 1, "in_list_view": 1},
    {"fieldname": "project_code", "label": "Project Code", "fieldtype": "Data", "reqd": 1, "unique": 1},
    {"fieldname": "client", "label": "Client", "fieldtype": "Link", "options": "Customer", "reqd": 1},
    {"fieldname": "construction_site", "label": "Construction Site", "fieldtype": "Link", "options": "Construction Site", "reqd": 1, "in_list_view": 1},
    {"fieldname": "project_type", "label": "Project Type", "fieldtype": "Select", "options": "Residential\nCommercial\nIndustrial\nInfrastructure\nRenovation\nOther", "reqd": 1, "in_standard_filter": 1},
    {"fieldname": "contract_value", "label": "Contract Value", "fieldtype": "Currency", "reqd": 1},
    {"fieldname": "start_date", "label": "Start Date", "fieldtype": "Date", "reqd": 1},
    {"fieldname": "end_date", "label": "End Date", "fieldtype": "Date", "reqd": 1},
    {"fieldname": "project_manager", "label": "Project Manager", "fieldtype": "Link", "options": "User"},
    {"fieldname": "current_phase", "label": "Current Phase", "fieldtype": "Link", "options": "Construction Phase", "in_list_view": 1},
    {"fieldname": "completion_percentage", "label": "Completion %", "fieldtype": "Percent", "default": 0, "in_list_view": 1},
    {"fieldname": "budget_total", "label": "Total Budget", "fieldtype": "Currency"},
    {"fieldname": "actual_cost_to_date", "label": "Actual Cost to Date", "fieldtype": "Currency", "read_only": 1},
    {"fieldname": "status", "label": "Status", "fieldtype": "Select", "options": "Draft\nActive\nOn Hold\nCompleted\nCancelled", "default": "Draft", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1}
  ],
  "permissions": [
    {"role": "System Manager", "permlevel": 0, "read": 1, "write": 1, "create": 1, "delete": 1, "submit": 1, "cancel": 1},
    {"role": "Construction Project Manager", "permlevel": 0, "read": 1, "write": 1, "create": 1, "submit": 1},
    {"role": "Site Engineer", "permlevel": 0, "read": 1, "write": 1},
    {"role": "Construction Procurement Officer", "permlevel": 0, "read": 1}
  ]
}